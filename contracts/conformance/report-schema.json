{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo.digitalghana.dev/contracts/conformance/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "sdk", "apiVersion", "datasetVersion", "summary", "evidenceDigest", "evidence", "results"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contract": {
      "type": "object", "additionalProperties": false, "required": ["digest", "runnerVersion"],
      "properties": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "runnerVersion": { "const": "1.0.0" } }
    },
    "sdk": {
      "type": "object", "additionalProperties": false, "required": ["language", "name", "version", "supportedProtocols"],
      "properties": {
        "language": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
        "supportedProtocols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["rest", "grpc", "graphql"] } }
      }
    },
    "apiVersion": { "type": "string", "minLength": 1 },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["passed", "failed", "skipped"],
      "properties": { "passed": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 } }
    },
    "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["caseId", "protocol", "requestDigest", "responseDigest"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 }, "protocol": { "enum": ["rest", "grpc", "graphql"] },
          "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "responseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["caseId", "status", "protocols"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "skipped"] },
          "protocols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["rest", "grpc", "graphql"] } },
          "message": { "type": "string" }
        }
      }
    }
  }
}
