#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "lib"

abort "usage: scan-secrets FILE_OR_DIRECTORY..." if ARGV.empty?
paths = ARGV.flat_map { |path| File.directory?(path) ? Dir.glob(File.join(path, "**", "*")) : path }
matches = paths.select do |path|
  next false unless File.file?(path)
  content = File.binread(path)
  GhanaGeo::Conformance.contains_secret?(content)
end
unless matches.empty?
  warn "credential-shaped value found in: #{matches.join(', ')}"
  exit 1
end
