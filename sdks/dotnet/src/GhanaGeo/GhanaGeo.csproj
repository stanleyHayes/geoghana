<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GhanaGeo</PackageId>
    <Version>1.0.0</Version>
    <Description>Official, typed .NET client for the GhanaGeo API.</Description>
    <Authors>GhanaGeo contributors</Authors>
    <PackageTags>ghana;geography;geocoding;gis;api</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://geo.digitalghana.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ghanageo/ghanageo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
