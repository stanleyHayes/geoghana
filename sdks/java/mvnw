#!/bin/sh
set -eu
VERSION=3.9.9
SHA512=a555254d6b53d267965a3404ecb14e53c3827c09c3b94b5678835887ab404556bfaf78dcfe03ba76fa2508649dca8531c74bca4d5846513522404d48e8c4ac8b
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DIST="$ROOT/.build-tools/apache-maven-$VERSION"
if [ ! -x "$DIST/bin/mvn" ]; then
  mkdir -p "$ROOT/.build-tools"
  ARCHIVE="$ROOT/.build-tools/apache-maven-$VERSION.tgz"
  curl -fsSL "https://archive.apache.org/dist/maven/maven-3/$VERSION/binaries/apache-maven-$VERSION-bin.tar.gz" -o "$ARCHIVE"
  printf '%s  %s\n' "$SHA512" "$ARCHIVE" | shasum -a 512 -c -
  tar -xzf "$ARCHIVE" -C "$ROOT/.build-tools"
fi
HAS_FILE=false
for ARG in "$@"; do case "$ARG" in -f|--file|-f=*|--file=*) HAS_FILE=true;; esac; done
if [ "$HAS_FILE" = true ]; then exec "$DIST/bin/mvn" "$@"; fi
exec "$DIST/bin/mvn" -f "$ROOT/pom.xml" "$@"
