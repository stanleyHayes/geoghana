# ---- GhanaGeo local environment. Copy to .env. NEVER commit a real secret. ----
GHANAGEO_ENV=local

# MongoDB (single-node replica set — transactions require one)
MONGO_URI=mongodb://ghanageo:ghanageo@localhost:27117/ghanageo?replicaSet=rs0&authSource=admin
MONGO_DB=ghanageo

# Redis — cache + rate-limit counters
REDIS_URL=redis://localhost:6679

# Typesense — local SearchPort implementation
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=ghanageo_local_dev_only

# API
API_HTTP_PORT=8180
API_GRPC_PORT=9190
API_LOG_LEVEL=debug

# Frontends
NEXT_PUBLIC_GHANAGEO_API_URL=http://localhost:8180/v1
API_ALLOWED_ORIGINS=http://localhost:3103,http://localhost:3102,http://localhost:3101,http://localhost:3100
