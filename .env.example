# =============================================================================
# GhanaGeo — environment reference
#
# This file is COMMITTED and must never contain a real secret.
#
# To create your actual environment files:
#
#     ./scripts/gen-env.sh
#
# That generates .env and .env.production for every app and service, fills in
# every secret it can generate itself, and leaves PASTE_ placeholders for the
# values only you can supply. It is safe to re-run: anything you have already
# pasted is preserved.
#
# Find what still needs your input:
#     grep -rn 'PASTE_' --include='.env*' . | grep -v node_modules
#
# Rotate generator-managed development secrets only:
#     ./scripts/gen-env.sh --rotate-local
# Production secrets are never rotated by this script because a dotenv file
# cannot prove whether a value was generated or pasted. Rotate them at their
# provider, update .env.production, then rerun without a rotation flag.
# =============================================================================

GHANAGEO_ENV=local

# --- Generated for you -------------------------------------------------------
# gen-env.sh creates these with `openssl rand`. Never reuse a value across
# environments, and never move a local value into production.
MONGO_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
TYPESENSE_API_KEY=<generated>
INTERNAL_SERVICE_TOKEN=<generated>   # shared between the API and the worker
AUTH_SECRET=<generated>              # session signing
SESSION_SECRET=<generated>

# --- Local service ports -----------------------------------------------------
# A dedicated block, because this machine runs other projects on the defaults.
# Change here and in docker-compose.yml together.
MONGO_PORT=27117
REDIS_PORT=6679
TYPESENSE_PORT=8108
API_HTTP_PORT=8180
API_GRPC_PORT=9190
WORKER_METRICS_PORT=9091
DATASET_VERSION=2026.08.3-ulid

# Traces are disabled locally unless explicitly requested. Use `stdout` for a
# quick local proof or `otlp` with an OTLP collector in production.
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Backend (services/api, services/worker) ---------------------------------
# directConnection is required for a single-node replica set reached from
# outside Docker. The replica set itself is required for transactions.
MONGO_URI=mongodb://localhost:27117/ghanageo?replicaSet=rs0&directConnection=true
MONGO_DB=ghanageo
REDIS_URL=redis://localhost:6679
TYPESENSE_URL=http://localhost:8108

# An allow-list, never a wildcard. An unlisted origin receives no CORS header
# at all, so the browser blocks it (Spec §12.4).
API_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:3103
# Production only: enable proxy headers together with the immediate edge
# networks that are allowed to supply them. Never use 0.0.0.0/0 or ::/0.
API_TRUST_PROXY_HEADERS=false
API_TRUSTED_PROXY_CIDRS=
API_REQUIRE_HTTPS=false

# --- Frontend (Next.js apps) -------------------------------------------------
# ONLY variables prefixed NEXT_PUBLIC_ reach the browser, and they are baked
# into the client bundle at build time. Anything secret must NOT carry that
# prefix.
NEXT_PUBLIC_GHANAGEO_API_URL=http://localhost:8180/v1
NEXT_PUBLIC_GHANAGEO_GRAPHQL_URL=http://localhost:8180/graphql
# Marketing canonical and cross-app destinations. Set INDEXABLE=true only on
# the one public production deployment; previews and staging stay noindex.
NEXT_PUBLIC_GHANAGEO_WEB_URL=http://localhost:3100
NEXT_PUBLIC_GHANAGEO_SANDBOX_URL=http://localhost:3101
NEXT_PUBLIC_GHANAGEO_PORTAL_URL=http://localhost:3102
NEXT_PUBLIC_GHANAGEO_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3103
NEXT_PUBLIC_ENVIRONMENT=local

# A BROWSER-class key is safe to expose: it is origin-restricted and
# scope-limited by construction, and cannot hold server-only scopes (Spec §32.5).
#   cd services/api && go run ./cmd/ghanageo-admin keys create \
#     --name "admin local" --class BROWSER --origins http://localhost:3103
NEXT_PUBLIC_GHANAGEO_BROWSER_KEY=<browser key>

# A SERVER-class key must never reach a client bundle. No NEXT_PUBLIC_ prefix.
GHANAGEO_SERVER_KEY=<server key>

# Optional locally; required for production operator paging. The receiver
# verifies the HMAC-SHA256 signature over the raw JSON request body.
SECURITY_ALERT_WEBHOOK_URL=<https webhook URL>
SECURITY_ALERT_WEBHOOK_SECRET=<generated>

# --- Production only: values you must paste ----------------------------------
# These have no sensible default and no way to be generated locally.
#
#   MONGO_URI            MongoDB Atlas → Connect → Drivers → Go
#   REDIS_URL            Upstash, Redis Cloud, or Render Key Value
#   TYPESENSE_URL        Typesense Cloud, or your own node
#   TYPESENSE_API_KEY    from that Typesense cluster
#   SENTRY_DSN           Sentry → Project Settings → Client Keys
#   RESEND_API_KEY       Resend → API Keys (transactional mail)
#   SECURITY_ALERT_WEBHOOK_URL     incident platform or operator webhook
#   SECURITY_ALERT_WEBHOOK_SECRET  shared HMAC signing secret
#
# In production, load these into the platform (Vercel, Render) rather than
# shipping a file. A .env.production on disk is a file that can be leaked.
