{
  "name": "ghanageo",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "seed": "cd services/api && go run ./cmd/ghanageo-admin data seed --file ../../data/seed-data/manifest.json",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "graphql": "16.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
