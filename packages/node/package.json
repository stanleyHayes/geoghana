{
  "name": "@ghanageo/node",
  "version": "0.1.0",
  "description": "Server-only GhanaGeo client helpers for Node.js",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok",
    "prepack": "pnpm build"
  },
  "dependencies": { "@ghanageo/client": "workspace:^" },
  "devDependencies": { "@types/node": "24.10.1", "tsup": "8.5.1", "typescript": "5.9.3", "vitest": "4.1.11" },
  "publishConfig": { "access": "public", "provenance": true }
}
